# ── Secrets / environment ─────────────────────────────────────────────
.env
.env.local
**/.env.local
*.pem

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / CDK ────────────────────────────────────────────────────────
node_modules/
cdk.out/
.cdk.staging/
*.js.map
dist/
build/

# ── Build artifacts ───────────────────────────────────────────────────
*.zip
*.tsbuildinfo

# ── AgentCore deployment build/staging (regenerated by scripts + CLI) ──
# Keep source (app/, agentcore.json, cdk/*.ts) but ignore generated/bundled bits.
deployment/**/.venv/
deployment/**/staging/
deployment/**/.cache/
deployment/**/.cli/
deployment/**/cdk.out/
deployment/**/dist/
deployment/**/uv.lock
**/.bedrock_agentcore.yaml
# Generated from src/ by scripts/sync_agent_src.sh — not source of truth.
deployment/coeagent/app/coe_supervisor/coe_agent/
deployment/coeagent/app/coe_supervisor/coe_channels/
deployment/coeagent/app/coe_supervisor/coe_shared/

# ── Local simulation / runtime ────────────────────────────────────────
.sim_output/
logs/
*.log

# ── OS / editor ───────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Video production working files (local only — not source) ──────────────
.env.bak*
docs/canva_assets/
docs/email_shots/
docs/voiceover/
docs/voiceover_v2/
