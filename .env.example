# ─────────────────────────────────────────────────────────────────────────────
# One Touch Resolve — environment configuration
# Copy to .env and fill in your values.  NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# --- Amazon Bedrock / AgentCore ---
# Fast, low-cost, reliable tool-calling model for the buyer/party-facing agents.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AGENTCORE_RUNTIME_ARN=            # populated after ./scripts/deploy_agent.sh
AGENTCORE_MEMORY_ID=             # populated after agent deploy

# --- AWS End User Messaging: SMS + RCS ---
# RCS->SMS automatic fallback REQUIRES a phone pool that contains an AWS RCS Agent
# AND at least one dedicated SMS number/sender ID valid for the destination country.
# Shared routes are NOT supported for RCS fallback.
EUM_PHONE_POOL_ID=               # e.g. pool-a1b2c3d4e5f6g7h8i  (recommended origin)
EUM_RCS_AGENT_ID=                # e.g. rcs-a1b2c3d4
EUM_ORIGINATION_IDENTITY=        # pool ARN/ID used as OriginationIdentity in SendTextMessage
EUM_INBOUND_SNS_TOPIC_ARN=       # two-way messaging SNS topic (RCS/SMS inbound)

# --- AWS End User Messaging Social: WhatsApp ---
WHATSAPP_PHONE_NUMBER_ID=        # EUM Social WhatsApp origination phone number id
WHATSAPP_INBOUND_SNS_TOPIC_ARN=  # SNS topic that receives inbound WhatsApp events

# --- Amazon SES ---
SES_SENDER_EMAIL=claims@example.com   # must be a verified SES identity
SES_CONFIGURATION_SET=coe-claims      # optional, for open/bounce tracking

# --- DynamoDB (created by CDK) ---
CLAIMS_TABLE_NAME=coe-claims
DEDUPE_TABLE_NAME=coe-dedupe          # inbound message de-dupe (idempotency), TTL-expired
DEDUPE_TTL_SECONDS=86400             # how long a processed message id is remembered (24h)

# --- Demo / simulation ---
# When true, channel adapters log payloads instead of calling live carriers.
# Lets you run the full end-to-end journey with no live phone numbers.
SIMULATE_CHANNELS=true
DEMO_CLAIMANT_PHONE=+15555550100
DEMO_REPAIR_SHOP_PHONE=+15555550111

# --- Demo video recipients (LOCAL .env ONLY — keep generic in the repo) ---
# For filming, point these at REAL inboxes you can open on camera (e.g. WorkMail
# mailboxes on your org's *.awsapps.com domain) so the video shows actual
# per-party emails arriving. Leave them at the @example.com placeholders in the
# committed repo — the code only sends real party notices when these are set to
# non-@example.com addresses, so a plain clone/CI run never emails a real person.
DEMO_LIENHOLDER_EMAIL=lienholder@example.com   # lienholder coverage/settlement notice
DEMO_PARTS_EMAIL=parts@example.com             # parts-supplier notice
ZCAA_SUMMARY_EMAIL=                            # claimant summary (falls back to SES_SENDER_EMAIL)
DEMO_WHATSAPP_TO=                              # claimant WhatsApp number for live sends (E.164)
